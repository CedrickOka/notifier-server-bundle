{
    "name" : "coka/notifier-server-bundle",
    "type" : "symfony-bundle",
    "description" : "Notifier Server Bundle for send notification on many channels",
    "homepage" : "https://github.com/CedrickOka/notifier-server-bundle",
    "keywords" : [
        "notification",
        "REST",
        "messenger"
    ],
    "license" : "MIT",
    "autoload" : {
        "psr-4" : {
            "Oka\\Notifier\\ServerBundle\\" : "src/"
        },
        "files" : [
            "vendor/onlinecity/php-smpp/autoload.php"
        ],
        "exclude-from-classmap" : [
            "/tests/"
        ]
    },
    "autoload-dev" : {
        "psr-4" : {
            "Oka\\Notifier\\ServerBundle\\Tests\\" : "tests/"
        }
    },
    "require" : {
        "php": ">=8.2",
        "coka/input-handler-bundle": "^2.0",
        "coka/notifier-message": "^2.0",
        "symfony/amqp-messenger": "^5.4 || ^6.4 || ^7.4",
        "symfony/config": "^5.4 || ^6.4 || ^7.4",
        "symfony/console": "^5.4 || ^6.4 || ^7.4",
        "symfony/dependency-injection": "^5.4 || ^6.4 || ^7.4",
        "symfony/http-client": "^5.4 || ^6.4 || ^7.4",
        "symfony/messenger": "^5.4 || ^6.4 || ^7.4",
        "symfony/property-access": "^5.4 || ^6.4 || ^7.4",
        "symfony/property-info": "^5.4 || ^6.4 || ^7.4",
        "symfony/serializer": "^5.4 || ^6.4 || ^7.4",
        "symfony/yaml": "^5.4 || ^6.4 || ^7.4"
    },
    "require-dev" : {
        "coka/pagination-bundle": "^6.0",
        "doctrine/doctrine-bundle": "^2.5",
        "doctrine/mongodb-odm-bundle": "^4.7 || ^5.6",
        "doctrine/orm": "^2.4.8",
        "friendsofphp/php-cs-fixer": "^3",
        "kreait/firebase-bundle": "^4.1 || ^5.7 || ^6.1",
        "symfony/browser-kit": "^5.4 || ^6.4 || ^7.4",
        "symfony/framework-bundle": "^5.4 || ^6.4 || ^7.4",
        "symfony/mailer": "^5.4 || ^6.4 || ^7.4",
        "symfony/monolog-bundle": "^3.7",
        "symfony/phpunit-bridge": "^5.4 || ^6.4 || ^7.4"
    },
    "config" : {
        "sort-packages" : true
    },
    "extra" : {
        "branch-alias" : {
            "dev-master" : "1.x-dev"
        },
        "symfony" : {
            "allow-contrib": "true"
        }
    },
    "support" : {
        "docs" : "https://github.com/CedrickOka/notifier-server-bundle/blob/master/docs/index.md"
    }
}
